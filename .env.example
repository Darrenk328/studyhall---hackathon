# Copy to .env and fill in. Never commit .env.
YDC_API_KEY=
# Optional locally if you ran `ant auth login`; required for hosted deploys.
ANTHROPIC_API_KEY=

# Dev disk cache for You.com search/contents responses (1 = on). Saves credits while iterating.
STUDYHALL_CACHE=1
STUDYHALL_CACHE_DIR=.cache/studyhall

# Global cap on answered questions per UTC day (cost guard for public demos).
DAILY_QUESTION_CAP=500

# Shared rate limit and daily cap on a deploy (Upstash Redis REST). Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works. Unset = in-memory (local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
