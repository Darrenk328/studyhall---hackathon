# Copy to .env at the repo root and fill in. Never commit .env (it's gitignored).
# On Vercel, set these in Project Settings → Environment Variables instead.

# ---- Required ---------------------------------------------------------------

# Anthropic API key (console.anthropic.com). Needed on Vercel, and locally unless you've run `ant auth login`.
ANTHROPIC_API_KEY=
# You.com API key (you.com/platform): search, page contents and, for evals, the Research API. Prepaid; HTTP 402 means the credit has run out.
YDC_API_KEY=

# ---- Limits (public deploys) ------------------------------------------------

# Global cap on answered questions per UTC day, so a shared link can't drain credits (default 500; use 100 for the demo deploy).
DAILY_QUESTION_CAP=500
# Upstash Redis REST URL for the shared per-IP rate limit and daily cap. Unset = per-instance memory (fine locally).
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token, paired with the URL above.
UPSTASH_REDIS_REST_TOKEN=
# Same as the two above, under the names Vercel's Upstash integration sets automatically. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Local development only -------------------------------------------------

# Disk cache for You.com responses (1 = on) to save credits while iterating. Always off when NODE_ENV=production; evals turn it off themselves.
STUDYHALL_CACHE=1
# Where the dev cache lives, relative to the repo root.
STUDYHALL_CACHE_DIR=.cache/studyhall
# 1 = re-run the recorded planted-error checks against the live model during `pnpm test` (costs a few cents).
STUDYHALL_LIVE=
# Base URL of a running app for the screenshot and keyboard-check scripts (default http://localhost:3123).
BASE_URL=
