{
  "name": "studyhall",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @studyhall/core build && pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @studyhall/core build && pnpm -r typecheck",
    "smoke": "pnpm --filter core smoke",
    "ask": "pnpm --silent --filter core ask",
    "eval": "pnpm --silent --filter core eval"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
